# ─────────────────────────────────────────────────────────────────────────────
# Chhabra Store — PUBLIC app settings for local builds. Copy to `.env`.
# `.env` is git-ignored. GitHub Actions builds this file from GitHub Secrets.
#   flutter run --dart-define-from-file=.env
#
# ⚠️ NEVER put these here (or anywhere in the app): the Supabase service-role key,
#    RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET. They live in Supabase Secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase → Project Settings → API Keys → "publishable" (or legacy "anon public") key
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Must match supabase/seed/seed.sql
SHOP_SLUG=chhabra-general-store

# Where the web app lives (password-reset links open here)
WEB_APP_URL=https://YOUR_GITHUB_NAME.github.io/YOUR_REPO/app/
